# ============================================================
# Server-side only. These are read by the Netlify Functions in
# netlify/functions/ and are NEVER bundled into the browser.
#
# Local dev:  copy to .env  (already gitignored) and run `netlify dev`
# Production: set them in Netlify -> Site configuration -> Environment variables
#
# Do not prefix any of these with VITE_ — that would expose them to the client.
# ============================================================

# Backblaze B2 application key with read+write access to the bucket below
B2_KEY_ID=
B2_APPLICATION_KEY=

# The bucket the admin panel manages. Keep it PRIVATE — previews are served
# through short-lived signed download URLs.
B2_BUCKET_ID=
B2_BUCKET_NAME=

# Single admin password for /admin. Changing it invalidates all live sessions.
ADMIN_PASSWORD=
